# ============================================================
# StreamHub — Docker Compose Environment Variables
# ============================================================
# Copy karo: cp .env.example .env
# Phir values fill karo, .env ko kabhi commit mat karna
# ============================================================

# ── DATABASE ─────────────────────────────────────────────────
DB_NAME=streamhubdb
DB_PASSWORD=root

# ── REDIS ────────────────────────────────────────────────────
# Redis password set karo — passwordless Redis koi bhi access kar sakta hai
REDIS_PASSWORD=streamhub_redis_pass

# ── JWT ──────────────────────────────────────────────────────
# 64+ characters ka random secret — apna khud generate karo:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_to_a_64_char_random_secret_before_running_anything_real
JWT_ISSUER=streamhub.com
JWT_ACCESS_TTL_SECONDS=300
JWT_REFRESH_TTL_SECONDS=86400
JWT_REFRESH_COOKIE_NAME=refreshToken
JWT_ADMIN_REFRESH_COOKIE_NAME=adminRefreshToken
JWT_COOKIE_SECURE=false
JWT_COOKIE_HTTP_ONLY=true
JWT_COOKIE_SAME_SITE=lax
JWT_COOKIE_DOMAIN=localhost

# ── ADMIN CREDENTIALS ────────────────────────────────────────
# Strong password use karo (min 8 chars, 1 letter, 1 number, 1 special char).
# Blank chhodne par app ek random strong password generate karke log karega.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@12345
# false karne par default admin create hi nahi hoga
ADMIN_SEED_ENABLED=true

# ── FRONTEND URLS ─────────────────────────────────────────────
FRONT_END_URL=http://localhost:1304
FRONT_END_SUCCESS_REDIRECT=http://localhost:1304/oauth/success
FRONT_END_FAILURE_REDIRECT=http://localhost:1304/oauth/failure

# ── GOOGLE OAUTH2 ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=test-client-id
GOOGLE_CLIENT_SECRET=test-client-secret

# ── GITHUB OAUTH2 ─────────────────────────────────────────────
GITHUB_CLIENT_ID=test-client-id
GITHUB_CLIENT_SECRET=test-client-secret

# ── SPRING PROFILE ───────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── RATE LIMITING (brute-force protection) ───────────────────
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=15
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_OTP_WINDOW=15
RATE_LIMIT_RESEND_MAX=3
RATE_LIMIT_RESEND_WINDOW=60

# ── OTP ──────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
# Har OTP hamesha random hai. Koi fixed/universal code (jaise 123456) NAHI hai.
# Dev me real OTP console me log hota hai (testing ke liye) — prod me OFF.
OTP_LOG_ENABLED=false
